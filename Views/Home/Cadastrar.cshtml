<h1>Cadastrar carro</h1>

<form method="post">
    <p>Marca: <input name="Marca" required /></p>
    <p>Modelo: <input name="Modelo" required /></p>
    <p>Ano: <input name="Ano" type="number" required /></p>
    <p>Preço: <input name="Preco" type="number" step="0.01" required /></p>
    <p>Quilometragem: <input name="Quilometragem" type="number" required /></p>
    <p>Cor: <input name="Cor" /></p>
    <p>Descrição: <br /><textarea name="Descricao" rows="4" cols="40"></textarea></p>
    <button type="submit">Salvar</button>
</form>
